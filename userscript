    function cleanFloatingForesightStickyElements() {
        const control = document.getElementById(CONFIG.ids.control);

        const suspiciousTextPatterns = [
            "Work In Progress",
            "SLAM received",
            "Stacking Filter",
            "Next CPT",
            "Page automatically refreshed",
            "Data based on projections",
            "Chute"
        ];

        document.querySelectorAll("body *").forEach(el => {
            if (!el || el === document.body || el === document.documentElement) return;
            if (control && (el === control || control.contains(el))) return;
            if (el.id === "fcv-pro-creator-signature") return;
            if (el.id && String(el.id).startsWith("fcv-pro")) return;
            if (el.closest && el.closest("[id^='fcv-pro-']")) return;

            const cs = window.getComputedStyle(el);
            const text = norm(el.textContent || "");
            const rect = el.getBoundingClientRect();

            const hasForesightTableText = suspiciousTextPatterns.some(pattern => text.includes(pattern));

            const isFloating =
                cs.position === "fixed" ||
                cs.position === "sticky" ||
                el.style.position === "fixed" ||
                el.style.position === "sticky";

            const isLargeMiddleFloating =
                isFloating &&
                hasForesightTableText &&
                rect.width > window.innerWidth * 0.45 &&
                rect.height > 40;

            if (isLargeMiddleFloating || (isFloating && hasForesightTableText)) {
                el.style.setProperty("position", "static", "important");
                el.style.setProperty("top", "auto", "important");
                el.style.setProperty("bottom", "auto", "important");
                el.style.setProperty("left", "auto", "important");
                el.style.setProperty("right", "auto", "important");
                el.style.setProperty("transform", "none", "important");
                el.style.setProperty("z-index", "auto", "important");
                el.style.setProperty("inset", "auto", "important");
                el.style.removeProperty("height");
                el.style.removeProperty("max-height");
            }
        });

        document.querySelectorAll("table thead, table thead tr, table thead th").forEach(el => {
            el.style.setProperty("position", "static", "important");
            el.style.setProperty("top", "auto", "important");
            el.style.setProperty("transform", "none", "important");
            el.style.setProperty("z-index", "auto", "important");
        });
    }


