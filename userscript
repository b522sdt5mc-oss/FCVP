    async function silentScanAllPagesForTopRecirc() {
        if (STATE.scanRunning) return;

        const now = Date.now();
        if (now - (STATE.lastAutoLaneScanMs || 0) < 120000) return;
        STATE.lastAutoLaneScanMs = now;

        const buttons = Array.from(document.querySelectorAll("button, [role='button']"))
            .map(button => ({ button, page: Number(norm(button.textContent)) }))
            .filter(item => Number.isInteger(item.page) && item.page > 0)
            .sort((a, b) => a.page - b.page);

        if (!buttons.length) {
            addRowsToCache(extractCurrentRows().rows);
            return;
        }

        const activeButton = buttons.find(item =>
            item.button.getAttribute("aria-current") === "page" ||
            item.button.getAttribute("aria-selected") === "true" ||
            item.button.className.includes("current") ||
            item.button.className.includes("selected")
        );

        const originalPage = activeButton ? activeButton.page : null;
        const seen = new Set();

        STATE.scanRunning = true;

        try {
            addRowsToCache(extractCurrentRows().rows);

            for (const item of buttons) {
                if (seen.has(item.page)) continue;
                seen.add(item.page);

                item.button.click();
                await sleep(CONFIG.scanDelayMs || 650);
                addRowsToCache(extractCurrentRows().rows);
            }

            if (originalPage !== null) {
                const returnButton = buttons.find(item => item.page === originalPage);
                if (returnButton) {
                    returnButton.button.click();
                    await sleep(CONFIG.scanDelayMs || 650);
                }
            }
        } finally {
            STATE.scanRunning = false;
        }
    }

